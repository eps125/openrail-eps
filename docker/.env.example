# Copy to .env and fill in.  Portainer: paste these as stack environment variables.

# ---- Container image ------------------------------------------------------
# Prebuilt image published by the GitHub Actions workflow to
# ghcr.io/<owner>/<repo>.  Override this if you rename the repo or deploy a fork,
# e.g.  OPENRAIL_IMAGE=ghcr.io/yourname/openrail-eps:latest
OPENRAIL_IMAGE=ghcr.io/eps125/openrail-eps:latest

# ---- Database (the bundled MariaDB container) --------------------------------
DB_NAME=rail
DB_USER=rail
DB_PASSWORD=change-me-app-password
DB_ROOT_PASSWORD=change-me-root-password
# DB_PORT=3306          # only used if you expose the db service
# InnoDB buffer pool - the single biggest performance lever.  Set to ~60-70% of
# the RAM you can give the DB container.
DB_BUFFER_POOL=4G

# ---- Network Rail Open Data feed account ------------------------------------
# Register at https://datafeeds.networkrail.co.uk/  (free).
# Without these, the DB and web UI still start but no live data is collected.
NR_USER=you@example.com
NR_PASSWORD=your-networkrail-password
NR_SERVER=datafeeds.networkrail.co.uk
# NR_STOMP_PORT=61618

# ---- Web / reports --------------------------------------------------------
# Host port for the web viewer (http://SERVER:<WEB_PORT>/).  Container port
# stays 80.  Change this value and redeploy the stack to move the viewer.
WEB_PORT=8080
# Public base URL used for links in report emails; must end with a slash.
PUBLIC_URL=http://localhost:8080/
# Space-separated recipients for alarm/report emails.  Needs a working MTA in
# the container (none is configured by default) - leave blank to disable.
REPORT_EMAIL=

# ---- STOMP topics (defaults match example.conf) ---------------------------
STOMP_TOPICS=VSTP_ALL;TRAIN_MVT_ALL_TOC;TD_ALL_SIG_AREA
STOMP_TOPIC_NAMES=VSTP;TRUST;TD
STOMP_TOPIC_LOG=false;false;false;false

# ---- Unit allocations (RDM "NWR Passenger Train Allocation and Consist") ----
# Subscribe to the product on https://raildata.org.uk/ , then paste the Kafka
# connection details it gives you.  The USER and PASSWORD are credentials - set
# them only in your private stack env, never commit them.
# Leave RDM_KAFKA_PASSWORD blank to disable the allocation consumer.
RDM_KAFKA_BOOTSTRAP=pkc-z3p1v0.europe-west2.gcp.confluent.cloud:9092
RDM_KAFKA_TOPIC=prod-1033-Passenger-Train-Allocation-and-Consist-1_0
RDM_KAFKA_GROUP=
RDM_KAFKA_USER=
RDM_KAFKA_PASSWORD=
# earliest = backfill from the start of the topic's retention; latest = only new.
RDM_KAFKA_OFFSET_RESET=latest
# Drop allocation rows for service dates older than this many days.
ALLOCATION_KEEP_DAYS=21

# ---- Misc ----------------------------------------------------------------
TZ=Europe/London
# INIT_FETCH_TIMETABLE=yes     # set to "no" to skip the big cifdb -a during init
# OPENRAIL_DEBUG=1             # verbose logging (also makes daemons run in foreground)
# TRUSTDB_NO_DEDUCE_ACT=1      # disable trustdb deduced-activation (lowers CPU)
# LIVE_SERVER=1               # disable destructive ops (e.g. cifdb -a)
