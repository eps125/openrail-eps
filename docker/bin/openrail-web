#!/usr/bin/env bash
#
# Apache front-end for the openrail CGI programs.
#
set -euo pipefail

openrail-render-config
mkdir -p /var/log/garner/web
chown -R www-data:www-data /var/log/garner/web

# Do NOT `source /etc/apache2/envvars` here: under `set -u` its unguarded
# ${APACHE_CONFDIR} reference aborts the script.  apache2ctl sources it itself
# in a plain shell before exec'ing apache2.
mkdir -p /var/run/apache2
rm -f /var/run/apache2/apache2.pid

exec apache2ctl -D FOREGROUND
