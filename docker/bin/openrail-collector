#!/usr/bin/env bash
#
# Runs stompy + vstpdb + trustdb + tddb in one container (they must share
# localhost because misc.c open_stompy() connects to "localhost").
#
# The daemons fork and detach, so we launch each one then supervise by
# pgrep/pidfile and restart any that die.
#
# stompy only forwards a stream once it has been told to "run" it (V/T/D via
# /tmp/stompy.cmd + SIGUSR1 - see stompy.c user_command()).  Every time a
# consumer (re)connects, stompy puts that stream back into LOCK, so we must
# re-assert the run commands after starting/restarting a consumer and
# periodically thereafter.  The command only promotes a LOCKed stream, so
# repeating it is harmless.  (Trade-off: a stream deliberately held via the
# lowercase v/t/d command will be released again within ~15s.)
#
set -uo pipefail

CONF=/etc/openrail.conf
DAEMONS=(stompy vstpdb trustdb tddb)
declare -A FLOW=( [vstpdb]=V [trustdb]=T [tddb]=D )   # stompy has no consumer

log() { echo "[collector $(date -u +%FT%TZ)] $*"; }

openrail-render-config
mkdir -p /var/log/garner/web /var/spool/stompy
for d in "${DAEMONS[@]}"; do : >> "/var/log/garner/${d}.log"; done

DB_SERVER=${DB_SERVER:-db}; DB_NAME=${DB_NAME:-rail}
DB_USER=${DB_USER:-rail};   DB_PASSWORD=${DB_PASSWORD:?}

log "Waiting for database ${DB_SERVER}/${DB_NAME} ..."
until mariadb -h"$DB_SERVER" -u"$DB_USER" -p"$DB_PASSWORD" \
        --connect-timeout=5 -e 'SELECT 1' "$DB_NAME" >/dev/null 2>&1; do
    sleep 3
done
log "Database is up."

assert_flows() {
    pgrep -x stompy >/dev/null 2>&1 || return 0
    printf 'VTD' > /tmp/stompy.cmd
    pkill -USR1 -x stompy 2>/dev/null || true
}

start_one() {
    local d=$1
    log "starting $d"
    "$d" -c "$CONF" || true
    if [ "$d" = stompy ]; then
        for _ in $(seq 1 30); do [ -f /var/run/stompy.pid ] && break; sleep 1; done
    fi
    sleep 2
}

shutdown() {
    log "signal received - shutting down"
    if pgrep -x stompy >/dev/null 2>&1; then
        printf 's' > /tmp/stompy.cmd          # controlled shutdown: flush spool
        pkill -USR1 -x stompy 2>/dev/null || true
        for _ in $(seq 1 25); do pgrep -x stompy >/dev/null 2>&1 || break; sleep 1; done
    fi
    for d in vstpdb trustdb tddb stompy; do pkill -TERM -x "$d" 2>/dev/null || true; done
    exit 0
}
trap shutdown TERM INT

for d in "${DAEMONS[@]}"; do
    start_one "$d"
    [ -n "${FLOW[$d]:-}" ] && assert_flows
done

# Surface the daemon logs on container stdout.
tail -n0 -F /var/log/garner/*.log &

log "supervising: ${DAEMONS[*]}"
tick=0
while true; do
    restarted=0
    for d in "${DAEMONS[@]}"; do
        if ! pgrep -x "$d" >/dev/null 2>&1; then
            log "$d is not running - restarting"
            start_one "$d"
            restarted=1
        fi
    done
    # Re-assert immediately after a restart, otherwise only every ~60s to keep
    # stompy's log quiet (there is no logrotate in the container).
    tick=$(( (tick + 1) % 4 ))
    { [ "$restarted" = 1 ] || [ "$tick" = 0 ]; } && assert_flows
    sleep 15 &
    wait $!
done
