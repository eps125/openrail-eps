#!/usr/bin/env bash
#
# Render /etc/openrail.conf from environment variables.
# Run by every container entrypoint before starting anything.
#
set -euo pipefail

CONF="${OPENRAIL_CONF:-/etc/openrail.conf}"

: "${DB_SERVER:=db}"
: "${DB_NAME:=rail}"
: "${DB_USER:=rail}"
: "${DB_PASSWORD:?DB_PASSWORD must be set}"
: "${NR_SERVER:=datafeeds.networkrail.co.uk}"
: "${STOMP_TOPICS:=VSTP_ALL;TRAIN_MVT_ALL_TOC;TD_ALL_SIG_AREA}"
: "${STOMP_TOPIC_NAMES:=VSTP;TRUST;TD}"
: "${STOMP_TOPIC_LOG:=false;false;false;false}"

umask 077
{
    echo "# Generated by openrail-render-config at $(date -u +%FT%TZ) - do not edit."
    echo "db_server ${DB_SERVER}"
    echo "db_name ${DB_NAME}"
    echo "db_user ${DB_USER}"
    echo "db_password ${DB_PASSWORD}"
    echo "nr_server ${NR_SERVER}"
    [ -n "${NR_USER:-}" ]       && echo "nr_user ${NR_USER}"
    [ -n "${NR_PASSWORD:-}" ]   && echo "nr_password ${NR_PASSWORD}"
    [ -n "${NR_STOMP_PORT:-}" ] && echo "nr_stomp_port ${NR_STOMP_PORT}"
    [ -n "${REPORT_EMAIL:-}" ]  && echo "report_email ${REPORT_EMAIL}"
    [ -n "${PUBLIC_URL:-}" ]    && echo "public_url ${PUBLIC_URL}"
    echo "stomp_topics ${STOMP_TOPICS}"
    echo "stomp_topic_names ${STOMP_TOPIC_NAMES}"
    echo "stomp_topic_log ${STOMP_TOPIC_LOG}"
    [ -n "${TRUSTDB_NO_DEDUCE_ACT:-}" ] && echo "trustdb_no_deduce_act"
    [ -n "${LIVE_SERVER:-}" ]            && echo "live_server"
    [ -n "${OPENRAIL_DEBUG:-}" ]         && echo "debug"
} > "$CONF"

chmod 0640 "$CONF"
