[mysqld]
# openrail writes a lot of rows and CIF loads can be large.
character-set-server        = utf8mb4
collation-server            = utf8mb4_general_ci
max_allowed_packet          = 256M
innodb_buffer_pool_size     = 1G
innodb_flush_log_at_trx_commit = 2
innodb_flush_method         = O_DIRECT
innodb_file_per_table       = 1
max_connections             = 200

# openrail was written for classic MySQL read semantics and does not retry
# failed queries.  MariaDB 11.6+ defaults innodb_snapshot_isolation=ON, which
# makes a transaction that reads then updates a row another session changed
# fail with ER_CHECKREAD (1020).  trustdb does exactly that on the single-row
# `status` table while tddb hammers it, so it loses the connection on every
# movement and TRUST ingest stalls.  Turn it off to restore the old behaviour.
# (loose- so older MariaDB that lacks the variable still starts.)
loose-innodb_snapshot_isolation = OFF

# The timetable + movement history grows steadily - keep an eye on the volume.
