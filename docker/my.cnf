[mysqld]
# ---------------------------------------------------------------------------
# openrail-eps MariaDB tuning.  Write-heavy: TD ~6k rows/min, TRUST ~2k/min,
# plus the CGI readers.  Sized for a VM with >= ~6 GB RAM free for the DB.
# ---------------------------------------------------------------------------

character-set-server            = utf8mb4
collation-server                = utf8mb4_general_ci
skip-name-resolve                = 1
max_connections                 = 300
max_allowed_packet              = 256M

# --- InnoDB memory ---
innodb_buffer_pool_size         = 4G
innodb_log_buffer_size          = 128M
# Warm the cache fast after a container restart (redeploys recreate this
# container, and a cold buffer pool is what makes tddb lag afterwards).
innodb_buffer_pool_dump_at_shutdown = 1
innodb_buffer_pool_load_at_startup  = 1
innodb_buffer_pool_dump_pct         = 75

# --- InnoDB redo log: large = far fewer checkpoint flushes = higher sustained
#     write rate.  Online-resizable on MariaDB 11, safe to change.
innodb_log_file_size            = 1G

# --- InnoDB durability: 2 = lose <=1s of data only if the *host* crashes
#     (a mysqld crash loses nothing).  Fine for reconstructible rail data.
#     Set to 0 to squeeze a little more write throughput.
innodb_flush_log_at_trx_commit  = 2
innodb_flush_method             = O_DIRECT
innodb_doublewrite              = 1
innodb_file_per_table           = 1

# --- InnoDB I/O: assumes SSD/NVMe-backed storage ---
innodb_io_capacity              = 2000
innodb_io_capacity_max          = 4000
innodb_flush_neighbors          = 0
innodb_read_io_threads          = 8
innodb_write_io_threads         = 8
innodb_purge_threads            = 4
innodb_lru_scan_depth           = 1024
innodb_change_buffering         = all
loose-innodb_snapshot_isolation = OFF   # MariaDB 11.6+ default ON breaks trustdb

# --- Caches / temp ---
query_cache_type                = 0
query_cache_size                = 0
table_open_cache                = 4000
table_definition_cache          = 2000
tmp_table_size                  = 256M
max_heap_table_size             = 256M
join_buffer_size                = 8M
sort_buffer_size                = 8M
read_rnd_buffer_size            = 4M

# The timetable + TRUST history grows steadily; archdb (cron, -a 90) trims it.
